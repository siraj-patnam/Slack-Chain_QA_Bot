# Copy to `.env` and fill in. NEVER commit the real .env.

# --- Model provider (OpenAI) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_JUDGE_MODEL=gpt-4o-mini

# --- Slack (Events API) ---
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# PORT=3000  # webhook server port (default 3000)

# --- Agent ---
# Use the custom StateGraph (default). Set to false/0/no to fall back to the
# prebuilt create_agent.
# USE_GRAPH=true

# --- LangSmith (optional tracing/eval) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=slack-qa-bot

# --- Data ---
# Place the take-home SQLite file here (it is gitignored).
DB_PATH=data/synthetic_startup.sqlite
# Multi-turn memory is checkpointed here (gitignored); defaults to the value below.
# CHECKPOINT_DB_PATH=data/checkpoints.sqlite
